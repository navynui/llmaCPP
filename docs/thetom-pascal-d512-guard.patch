diff --git a/ggml/src/ggml-cuda/CMakeLists.txt b/ggml/src/ggml-cuda/CMakeLists.txt
index 403babb87..5bb54b845 100644
--- a/ggml/src/ggml-cuda/CMakeLists.txt
+++ b/ggml/src/ggml-cuda/CMakeLists.txt
@@ -99,6 +99,36 @@ if (CUDAToolkit_FOUND)
     endif()
     message(STATUS "Using CMAKE_CUDA_ARCHITECTURES=${CMAKE_CUDA_ARCHITECTURES} CMAKE_CUDA_ARCHITECTURES_NATIVE=${CMAKE_CUDA_ARCHITECTURES_NATIVE}")
 
+    # Pascal (sm_60/sm_61) allows 48 KB shared memory per block but the D=512
+    # fattn-vec kernels with turbo V need ~65 KB and fail in ptxas. Skip them
+    # when all target archs predate sm_70. D=512 decode then uses TILE.
+    set(_ggml_cuda_max_arch 0)
+    foreach(_arch ${CMAKE_CUDA_ARCHITECTURES})
+        if (_arch MATCHES "^[0-9]+")
+            string(REGEX MATCH "^[0-9]+" _arch_num "${_arch}")
+            if (_arch_num GREATER _ggml_cuda_max_arch)
+                set(_ggml_cuda_max_arch ${_arch_num})
+            endif()
+        endif()
+    endforeach()
+    if (_ggml_cuda_max_arch GREATER 0 AND _ggml_cuda_max_arch LESS 70)
+        add_compile_definitions(GGML_CUDA_NO_D512_TURBO_VEC)
+    endif()
+    # Mixed old+new archs (e.g. 60;80) keep D512 turbo and still fail ptxas
+    # for sm_60. Build Pascal (60;61) apart from newer archs.
+    set(_ggml_cuda_min_arch 999)
+    foreach(_arch ${CMAKE_CUDA_ARCHITECTURES})
+        if (_arch MATCHES "^[0-9]+")
+            string(REGEX MATCH "^[0-9]+" _arch_num "${_arch}")
+            if (_arch_num LESS _ggml_cuda_min_arch)
+                set(_ggml_cuda_min_arch ${_arch_num})
+            endif()
+        endif()
+    endforeach()
+    if (_ggml_cuda_min_arch LESS 70 AND _ggml_cuda_max_arch GREATER_EQUAL 70)
+        message(WARNING "CUDA archs span Pascal and newer GPUs, D=512 turbo VEC will fail ptxas on sm_60/sm_61. Build 60;61 separately.")
+    endif()
+
     file(GLOB   GGML_HEADERS_CUDA "*.cuh")
     list(APPEND GGML_HEADERS_CUDA "../../include/ggml-cuda.h")
 
